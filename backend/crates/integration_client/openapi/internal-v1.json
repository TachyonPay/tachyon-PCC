  "components": {
    "schemas": {
      "AckResponse": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "AllowanceDto": {
        "type": "object",
        "description": "An active allowance as the worker tracks it. The on-chain policies are authoritative.",
        "required": [
          "owner",
          "chainId",
          "token",
          "maxAmount",
          "usesRemaining",
          "validUntil"
        ],
        "properties": {
          "chainId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "mandateId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Autopay mandate the allowance belongs to; absent = the payer's checkout allowance."
          },
          "maxAmount": {
            "$ref": "#/components/schemas/BaseUnits",
            "description": "Inclusive cap for each transfer."
          },
          "owner": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "usesRemaining": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "validUntil": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "AllowanceKeyDto": {
        "type": "object",
        "description": "One allowance is identified by payer, chain and token.",
        "required": [
          "owner",
          "chainId",
          "token"
        ],
        "properties": {
          "chainId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "mandateId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Autopay mandate the allowance belongs to; absent = the payer's checkout allowance."
          },
          "owner": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "AssetsResponse": {
        "type": "object",
        "required": [
          "tokens",
          "fetchedAt"
        ],
        "properties": {
          "fetchedAt": {
            "type": "string"
          },
          "tokens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TokenEntry"
            }
          }
        }
      },
      "BaseUnits": {
        "type": "string",
        "description": "Token quantity in base units as a decimal integer string (never a float).",
        "pattern": "^[0-9]+$"
      },
      "Confidentiality": {
        "type": "string",
        "description": "1Click `confidentiality`.",
        "enum": [
          "public",
          "basic",
          "advanced"
        ]
      },
      "DepositMode": {
        "type": "string",
        "description": "1Click `depositMode`.",
        "enum": [
          "SIMPLE",
          "MEMO"
        ]
      },
      "DepositPlanDto": {
        "type": "object",
        "description": "Deposit the session-key executor may perform. `to` and `quote_deposit_address`\nmust be the same 1Click deposit address from the verified quote; the worker\nrefuses a mismatch (quote-address substitution).",
        "required": [
          "attemptId",
          "chainId",
          "token",
          "from",
          "to",
          "quoteDepositAddress",
          "amount",
          "maxFeeWei",
          "approvalRef"
        ],
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/BaseUnits"
          },
          "approvalRef": {
            "type": "string"
          },
          "attemptId": {
            "type": "string"
          },
          "chainId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "from": {
            "type": "string"
          },
          "gasLimit": {
            "type": [
              "string",
              "null"
            ]
          },
          "mandateId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Autopay mandate the allowance belongs to; absent = the payer's checkout allowance."
          },
          "maxFeeWei": {
            "$ref": "#/components/schemas/BaseUnits"
          },
          "quoteDepositAddress": {
            "type": "string",
            "description": "Verified quote deposit address; must equal `to`."
          },
          "to": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "description": "ERC-20 contract on the origin chain. Native deposits are refused."
          }
        }
      },
      "DepositSubmittedDto": {
        "type": "object",
        "required": [
          "depositAddress",
          "txHash"
        ],
        "properties": {
          "depositAddress": {
            "type": "string"
          },
          "txHash": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable machine-readable error codes returned by the worker.",
        "enum": [
          "UNAUTHORIZED",
          "INVALID_REQUEST",
          "AUTH_REF_REUSED",
          "UPSTREAM_TIMEOUT",
          "UPSTREAM_UNAUTHORIZED",
          "UPSTREAM_RATE_LIMITED",
          "UPSTREAM_REJECTED",
          "UPSTREAM_UNAVAILABLE",
          "MALFORMED_UPSTREAM",
          "SIGNATURE_INVALID",
          "NO_ROUTE",
          "SESSION_REJECTED",
          "INTERNAL"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "ExecuteResponseDto": {
        "type": "object",
        "required": [
          "userOpHash",
          "txHash"
        ],
        "properties": {
          "txHash": {
            "type": "string"
          },
          "userOpHash": {
            "type": "string"
          }
        }
      },
      "GrantEnableDto": {
        "type": "object",
        "required": [
          "grantId",
          "signature"
        ],
        "properties": {
          "grantId": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      },
      "GrantPrepareDto": {
        "type": "object",
        "description": "Ask the worker for a spending allowance the payer will sign once.",
        "required": [
          "owner",
          "chainId",
          "token",
          "maxAmount",
          "uses",
          "validitySec"
        ],
        "properties": {
          "chainId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "mandateId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Autopay mandate the allowance belongs to; absent = the payer's checkout allowance."
          },
          "maxAmount": {
            "$ref": "#/components/schemas/BaseUnits",
            "description": "Inclusive cap for each transfer."
          },
          "owner": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "description": "ERC-20 the session key may transfer."
          },
          "uses": {
            "type": "integer",
            "format": "int32",
            "description": "Transfers allowed in total (1..=20); enforced on-chain by a rate-limit policy.",
            "minimum": 0
          },
          "validitySec": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds until the allowance expires (600..=30 days).",
            "minimum": 0
          }
        }
      },
      "GrantPreparedDto": {
        "type": "object",
        "required": [
          "grantId",
          "typedData",
          "sessionSigner",
          "uses",
          "validUntil",
          "expiresAt"
        ],
        "properties": {
          "expiresAt": {
            "type": "string"
          },
          "grantId": {
            "type": "string"
          },
          "sessionSigner": {
            "type": "string"
          },
          "typedData": {
            "type": "object",
