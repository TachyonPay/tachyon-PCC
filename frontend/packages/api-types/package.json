{
  "name": "@pcc/api-types",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from the Rust-owned public OpenAPI (backend/crates/api/openapi/public-v1.json). Do not edit generated files.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen": "openapi-typescript ../../../backend/crates/api/openapi/public-v1.json -o src/public-v1.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
