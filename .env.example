# Private Crypto Checkout — example environment
# Copy to `.env` locally. NEVER commit a real `.env`. Secrets are read by the
# server processes only; nothing in this file is ever sent to a browser.

# ---------------------------------------------------------------------------
# Global safety gates (defaults are the SAFE values; the code also defaults to
# these if the variables are missing or malformed)
# ---------------------------------------------------------------------------
DRY_RUN=true
ENABLE_MAINNET_TRANSFERS=false
# Mock authenticator is compiled only with the `dev-mock` cargo feature and is
# additionally gated by this flag. Must be false in any deployed build.
ALLOW_MOCK_AUTHENTICATOR=false

# ---------------------------------------------------------------------------
# Rust API (backend/crates/api)
# ---------------------------------------------------------------------------
API_BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://pcc:pcc@127.0.0.1:5432/pcc
RUST_LOG=info,pcc=debug

# Internal boundary Rust -> TS integration worker. Loopback only.
INTEGRATIONS_BASE_URL=http://127.0.0.1:8787
# Shared bearer token for the private boundary (generate locally, e.g. `openssl rand -hex 32`).
INTEGRATIONS_INTERNAL_TOKEN=

# ---------------------------------------------------------------------------
# TS integration worker (services/integrations-ts) — private, loopback only
# ---------------------------------------------------------------------------
INTEGRATIONS_BIND_HOST=127.0.0.1
INTEGRATIONS_BIND_PORT=8787

# NEAR Intents 1Click API (https://1click.chaindefuser.com). Owner installs the
# real key locally; it is sent as the `X-API-Key` header only.
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=
# Set to "staging" only when testing against staging fixtures/keys.
ONECLICK_ENV=production

# ZeroDev (EIP-7702 / Kernel session keys). Project RPC from the ZeroDev dashboard.
ZERODEV_RPC_SEPOLIA=
ZERODEV_RPC_BASE=
ZERODEV_RPC_ARBITRUM=

# Public EVM RPC endpoints (review before use; no unreviewed endpoints).
RPC_URL_SEPOLIA=
RPC_URL_BASE=
RPC_URL_ARBITRUM=

# Backend-owned signers. Reference to an OS secret store entry or a local
# keystore path, NEVER a raw key in this file. Empty = no signer loaded.
# Wallet A (payer / source, small dedicated test wallet) is used ONLY by the
# M2 plain-EOA executor and never imported into any other component.
SOURCE_EXECUTOR_KEY_REF=
# Ephemeral session signer for the TS ZeroDev adapter (M3+). Separate from A/B.
SESSION_SIGNER_KEY_REF=

# Public addresses only (never keys). Used by `pcc-deposit preflight`.
# Wallet A = payer / refundTo on the origin chain. Wallet B = merchant recipient.
WALLET_A_ADDRESS=
WALLET_B_ADDRESS=

# ---------------------------------------------------------------------------
# Frontends (Next.js) — public config only, no secrets
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
