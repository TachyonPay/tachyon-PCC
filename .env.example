# Private Crypto Checkout — example environment
# Copy to `.env` locally. NEVER commit a real `.env`. Secrets are read by the
# server processes only; nothing in this file is ever sent to a browser.

# ---------------------------------------------------------------------------
# Global safety gates (defaults are the SAFE values; the code also defaults to
# these if the variables are missing or malformed)
# ---------------------------------------------------------------------------
DRY_RUN=true
ENABLE_MAINNET_TRANSFERS=false
# Mock authenticator is compiled only with the `dev-mock` cargo feature and is
# additionally gated by this flag. Must be false in any deployed build.
ALLOW_MOCK_AUTHENTICATOR=false

# ---------------------------------------------------------------------------
# Rust API (backend/crates/api)
# ---------------------------------------------------------------------------
API_BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://pcc:pcc@127.0.0.1:5432/pcc
RUST_LOG=info,pcc=debug

# Internal boundary Rust -> TS integration worker. Loopback only.
INTEGRATIONS_BASE_URL=http://127.0.0.1:8787
# Shared bearer token for the private boundary (generate locally, e.g. `openssl rand -hex 32`).
# Hosted checkout quotes and gated session execute require this to be set on both
# pcc-api and the TS worker. Empty = checkout authorize stays local (no 1Click).
INTEGRATIONS_INTERNAL_TOKEN=

# ---------------------------------------------------------------------------
# TS integration worker (services/integrations-ts) — private, loopback only
# ---------------------------------------------------------------------------
INTEGRATIONS_BIND_HOST=127.0.0.1
INTEGRATIONS_BIND_PORT=8787

# NEAR Intents 1Click API (https://1click.chaindefuser.com). Owner installs the
# real key locally; it is sent as the `X-API-Key` header only.
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=
# Set to "staging" only when testing against staging fixtures/keys.
ONECLICK_ENV=production

# ZeroDev (EIP-7702 / Kernel session keys). Project RPC from the ZeroDev dashboard.
ZERODEV_RPC_SEPOLIA=
ZERODEV_RPC_BASE=
ZERODEV_RPC_ARBITRUM=

# Public EVM RPC endpoints (review before use; no unreviewed endpoints).
# Sepolia is M3-only (7702 account tests). 1Click has no testnet.
RPC_URL_SEPOLIA=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
# ERC-4337 bundlers for session-key deposits. Default: Pimlico public endpoints.
BUNDLER_RPC_BASE=
BUNDLER_RPC_ARBITRUM=
# How often pcc-api polls 1Click status for broadcast deposits (seconds, min 2).
SETTLEMENT_POLL_SECS=10

# Backend-owned signers. Reference to an OS secret store entry or a local
# keystore path, NEVER a raw key in this file. Empty = no signer loaded.
# Wallet A (payer / source, small dedicated test wallet) is used ONLY by the
# M2 plain-EOA CLI and the operator-run live/e2e scripts. The integrations
# worker (M11+) loads no wallet key: payers sign their own session grant and
# the worker holds the session key. Set GRANT_STORE_KEY to encrypt those keys
# at rest so a restart keeps the allowance; unset means memory only.
SOURCE_EXECUTOR_KEY_REF=
# Fixed session signer for the M3-M5 live scripts only. Unused by the worker.
SESSION_SIGNER_KEY_REF=
# Worker bundler: `kernel` (default; real ZeroDev Kernel + Pimlico) or `memory`
# (in-process fake for local UI work; never sends anything).
AA_BUNDLER=
# Persist-then-send ledger for session UserOps (directory). Default `.pcc-aa-ledger`.
SESSION_LEDGER_DIR=
# Encrypt active allowance session keys (AES-256-GCM). ≥ 32 characters. Unset = memory only.
# Name only here; put the value in `.env` or the OS secret store, never in git.
GRANT_STORE_KEY=
# Directory for the encrypted allowance file. Default `.pcc-grant-store`.
GRANT_STORE_DIR=

# Public addresses only (never keys). Used by `pcc-deposit preflight`.
# Wallet A = payer / refundTo on the origin chain. Wallet B = merchant recipient.
WALLET_A_ADDRESS=
WALLET_B_ADDRESS=

# ---------------------------------------------------------------------------
# Frontends (Next.js) — public config only, no secrets
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Hosted checkout origin used when minting checkout URLs (loopback only).
CHECKOUT_BASE_URL=http://127.0.0.1:3000
# SIWE `domain` (host[:port]) payers sign. Default: host:port of CHECKOUT_BASE_URL.
SIWE_DOMAIN=
# Wrap key for TOTP secrets at rest (>= 32 chars). Unset or shorter = random
# per-process key + warning, so enrollments die on restart. Never log it.
TOTP_WRAP_KEY=

# Who releases a live send once gates are open. Default `payer`: the user's
# TOTP (or an autopay mandate) is enough. Only the exact value `owner` parks
# each deposit for an operator echo.
CHECKOUT_APPROVAL_MODE=payer
# >= 24 random chars. Stored only as a SHA-256 hash in memory. Never commit.
OPERATOR_APPROVAL_TOKEN=
# M12 invite-gated merchant signup (`X-Signup-Token`). >= 24 chars; unset = off.
MERCHANT_SIGNUP_TOKEN=
# Seed Alice/Bob demo merchants (keys are in docs/runbooks/m6-merchant-api.md, not logs).
PCC_DEMO_MERCHANTS=false
# Allow http://127.0.0.1 webhook URLs (local receivers only). Default false.
ALLOW_WEBHOOK_LOOPBACK=false
